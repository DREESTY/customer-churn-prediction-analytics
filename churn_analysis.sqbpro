s/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT
    RiskBand,
    CustomerValueBand,
    COUNT(*) AS customers,
    ROUND(
        SUM(ExpectedMonthlyRevenueAtRisk),
        2
    ) AS revenue_at_risk

FROM customer_churn

GROUP BY
    RiskBand,
    CustomerValueBand

ORDER BY revenue_at_risk DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
